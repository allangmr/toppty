DATABASE_URL=postgres://postgres:postgres@localhost:5432/toppty
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe. Leave empty locally to skip checkout and mark bids as paid.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

ADMIN_PASSWORD=change-me
IP_HASH_SALT=change-this-salt

# Local only. Ignored in production.
DEV_SKIP_STRIPE=true
# If Postgres is down locally, the homepage can still render sample listings.
