DATABASE_URL=postgres://postgres:postgres@localhost:5432/toppty
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PayPal Checkout. Leave empty locally to skip checkout and mark bids as paid.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# sandbox | live
PAYPAL_ENV=sandbox

ADMIN_PASSWORD=change-me
IP_HASH_SALT=change-this-salt

# hCaptcha for /admin/login (required in production)
NEXT_PUBLIC_HCAPTCHA_SITEKEY=
HCAPTCHA_SECRET=

# Local only. Ignored in production.
DEV_SKIP_PAYPAL=true
# If Postgres is down locally, the homepage can still render sample listings.
